{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.schemastore.org/ttheme-set.json",
  "title": "ttheme set",
  "description": "A set in a ttheme marketplace's sets/ folder: one or more palettes, usually one work's, each a [[palette]] table. The file's name means nothing to ttheme\nhttps://ttheme.dev/docs/guide/make#publish-a-marketplace",
  "type": "object",
  "definitions": {
    "color": {
      "description": "A color as #rrggbb, lowercase",
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "site": {
      "description": "A site ttheme find searches",
      "anyOf": [
        {
          "enum": ["danbooru", "konachan", "yande", "zerochan"]
        },
        {
          "type": "string"
        }
      ]
    },
    "shade": {
      "description": "The palette's colors in its other mode",
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/properties/palette/items/properties/colors/properties/background"
        },
        "foreground": {
          "$ref": "#/properties/palette/items/properties/colors/properties/foreground"
        },
        "cursor": {
          "$ref": "#/properties/palette/items/properties/colors/properties/cursor"
        },
        "selection_background": {
          "$ref": "#/properties/palette/items/properties/colors/properties/selection_background"
        },
        "ansi": {
          "$ref": "#/properties/palette/items/properties/colors/properties/ansi"
        }
      },
      "required": ["background", "foreground", "cursor", "selection_background", "ansi"]
    }
  },
  "properties": {
    "$schema": {
      "description": "This file's JSON Schema, for editor completion and checks; ttheme ignores it",
      "type": "string"
    },
    "palette": {
      "description": "The set's palettes, one [[palette]] table each; the tables that follow one, such as [palette.colors], belong to it",
      "type": "array",
      "items": {
        "description": "One ttheme palette: the colors a terminal shows, and the work or character they are of",
        "type": "object",
        "properties": {
          "slug": {
            "description": "The palette's name in its marketplace: <owner>@<marketplace>/<slug>, or ttheme/<slug> for a built-in one. No two palettes of a marketplace share a slug, whichever sets hold them",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 40
          },
          "subject": {
            "description": "What the palette is of: a work in the commons, as <work>, or one of its characters, as <work>/<character>. Lists shelve the palette under that work. A palette with no subject is an original, listed under its marketplace\nhttps://ttheme.dev/docs/guide/make#publish-a-marketplace",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)?$",
            "not": {
              "pattern": "^ttheme(?:/|$)"
            },
            "maxLength": 81
          },
          "upstream": {
            "description": "The palette this one was copied from, which it can take updates from: ttheme/<palette> for a built-in one, or <owner>@<marketplace>/<palette>",
            "type": "object",
            "properties": {
              "palette": {
                "description": "The upstream palette's full name",
                "type": "string",
                "pattern": "^(?:ttheme|[a-z0-9]+(?:-[a-z0-9]+)*@[a-z0-9]+(?:-[a-z0-9]+)*)/[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 121
              },
              "colors": {
                "description": "The upstream palette's colors when they were last taken, in the mode it was made in: the base an update compares both sides against",
                "type": "object",
                "properties": {
                  "background": {
                    "$ref": "#/definitions/color",
                    "description": "The terminal's background"
                  },
                  "foreground": {
                    "$ref": "#/definitions/color",
                    "description": "The text color"
                  },
                  "cursor": {
                    "$ref": "#/definitions/color",
                    "description": "The cursor's color"
                  },
                  "selection_background": {
                    "$ref": "#/definitions/color",
                    "description": "The background of selected text"
                  },
                  "ansi": {
                    "description": "The sixteen ANSI colors, black to bright white",
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/color"
                    },
                    "minItems": 16,
                    "maxItems": 16
                  },
                  "light": {
                    "description": "The palette in light mode, for a palette made dark. A built-in palette carries its other mode; without one, ttheme mirrors it",
                    "$ref": "#/definitions/shade"
                  },
                  "dark": {
                    "description": "The palette in dark mode, for a palette made light. A built-in palette carries its other mode; without one, ttheme mirrors it",
                    "$ref": "#/definitions/shade"
                  }
                },
                "required": ["background", "foreground", "cursor", "selection_background", "ansi"],
                "not": {
                  "properties": {
                    "light": {},
                    "dark": {}
                  },
                  "required": ["light", "dark"]
                }
              }
            },
            "required": ["palette"]
          },
          "colors": {
            "description": "The colors the terminal shows, in the mode the palette was made in: light when its background is lighter than its foreground",
            "type": "object",
            "properties": {
              "background": {
                "$ref": "#/definitions/color",
                "description": "The terminal's background"
              },
              "foreground": {
                "$ref": "#/definitions/color",
                "description": "The text color"
              },
              "cursor": {
                "$ref": "#/definitions/color",
                "description": "The cursor's color"
              },
              "selection_background": {
                "$ref": "#/definitions/color",
                "description": "The background of selected text"
              },
              "ansi": {
                "description": "The sixteen ANSI colors, black to bright white",
                "type": "array",
                "items": {
                  "$ref": "#/definitions/color"
                },
                "minItems": 16,
                "maxItems": 16
              },
              "light": {
                "description": "The palette in light mode, for a palette made dark. A built-in palette carries its other mode; without one, ttheme mirrors it",
                "$ref": "#/definitions/shade"
              },
              "dark": {
                "description": "The palette in dark mode, for a palette made light. A built-in palette carries its other mode; without one, ttheme mirrors it",
                "$ref": "#/definitions/shade"
              }
            },
            "required": ["background", "foreground", "cursor", "selection_background", "ansi"],
            "not": {
              "properties": {
                "light": {},
                "dark": {}
              },
              "required": ["light", "dark"]
            }
          },
          "picture": {
            "description": "Background pictures, by their post on a find site, with their framing",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "site": {
                  "$ref": "#/definitions/site",
                  "description": "The site the post is on"
                },
                "id": {
                  "description": "The post's number on the site",
                  "type": "integer",
                  "minimum": 1
                },
                "size": {
                  "description": "How large the picture is drawn: fill covers the window, a number is a percentage of it",
                  "anyOf": [
                    {
                      "const": "fill"
                    },
                    {
                      "type": "integer",
                      "minimum": 20,
                      "maximum": 999
                    }
                  ]
                },
                "position": {
                  "description": "Where the picture sits in the window",
                  "anyOf": [
                    {
                      "enum": [
                        "top-left",
                        "top-center",
                        "top-right",
                        "center-left",
                        "center",
                        "center-right",
                        "bottom-left",
                        "bottom-center",
                        "bottom-right"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "strength": {
                  "description": "How strongly the picture shows, as a multiple of the opacity ttheme starts it at for the installing user's colors and mode",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": ["site", "id"]
            },
            "minItems": 1,
            "maxItems": 255
          }
        },
        "required": ["slug", "colors"]
      },
      "minItems": 1
    }
  },
  "required": ["palette"]
}
