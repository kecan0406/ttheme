{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "off",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  },
  "overrides": [
    {
      "files": [
        "site/client/handoff.ts",
        "site/client/wear.ts",
        "src/cli/find/kept.ts",
        "src/cli/marketplaces.ts",
        "src/cli/refresh.ts",
        "src/cli/release.ts",
        "src/core/anchors.ts",
        "src/core/booru.ts",
        "src/core/commons.ts",
        "src/core/consensus.ts",
        "src/core/draft.ts",
        "src/core/manifest.ts",
        "src/core/own.ts",
        "src/core/theme.ts",
        "src/pictures/booru-net.ts",
        "src/store/available.ts",
        "src/store/derived.ts",
        "src/store/installed.ts",
        "src/store/marketplace-index.ts",
        "src/store/sources.ts",
        "src/store/tone.ts",
        "tests/parity/looks.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["src/core/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/store/**", "**/pictures/**", "**/terminals/**", "**/tui/**", "**/cli/**"],
                "message": "core imports nothing above it: core < store < pictures < terminals < tui < cli"
              },
              {
                "group": ["node:*", "node:*/*", "bun", "bun:*", "!node:crypto", "!node:path", "!node:zlib"],
                "message": "core does no I/O \u2014 that is store's, pictures' or a terminal's"
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "process",
            "message": "core does no I/O \u2014 that is store's, pictures' or a terminal's"
          },
          {
            "name": "fetch",
            "message": "core does no I/O \u2014 that is store's, pictures' or a terminal's"
          },
          {
            "name": "Bun",
            "message": "core does no I/O \u2014 that is store's, pictures' or a terminal's"
          }
        ]
      }
    },
    {
      "files": ["src/core/booru.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "core does no I/O \u2014 that is store's, pictures' or a terminal's"
          },
          {
            "name": "Bun",
            "message": "core does no I/O \u2014 that is store's, pictures' or a terminal's"
          }
        ]
      }
    },
    {
      "files": ["src/store/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/pictures/**", "**/terminals/**", "**/tui/**", "**/cli/**"],
                "message": "store imports nothing above it: core < store < pictures < terminals < tui < cli"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pictures/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/terminals/**", "**/tui/**", "**/cli/**"],
                "message": "pictures imports nothing above it: core < store < pictures < terminals < tui < cli"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/terminals/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/tui/**", "**/cli/**"],
                "message": "terminals imports nothing above it: core < store < pictures < terminals < tui < cli"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/tui/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/cli/**"],
                "message": "tui imports nothing above it: core < store < pictures < terminals < tui < cli"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/tui/ansi.ts",
        "src/tui/field.ts",
        "src/tui/keycaps.ts",
        "src/tui/keys.ts",
        "src/tui/motion.ts",
        "src/tui/pending.ts",
        "src/tui/screen.ts",
        "src/tui/style.ts",
        "src/tui/terminal.ts",
        "src/tui/zones.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/cli/**"],
                "message": "tui imports nothing above it: core < store < pictures < terminals < tui < cli"
              },
              {
                "group": [
                  "./*",
                  "./*/**",
                  "!./ansi.ts",
                  "!./field.ts",
                  "!./keycaps.ts",
                  "!./keys.ts",
                  "!./motion.ts",
                  "!./pending.ts",
                  "!./screen.ts",
                  "!./style.ts",
                  "!./terminal.ts",
                  "!./zones.ts"
                ],
                "message": "the runtime imports no part and no screen: runtime < parts < screens"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/tui/bar.ts",
        "src/tui/help.ts",
        "src/tui/hub.ts",
        "src/tui/notice.ts",
        "src/tui/parts.ts",
        "src/tui/qr.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/cli/**"],
                "message": "tui imports nothing above it: core < store < pictures < terminals < tui < cli"
              },
              {
                "group": [
                  "./*",
                  "./*/**",
                  "!./ansi.ts",
                  "!./field.ts",
                  "!./keycaps.ts",
                  "!./keys.ts",
                  "!./motion.ts",
                  "!./pending.ts",
                  "!./screen.ts",
                  "!./style.ts",
                  "!./terminal.ts",
                  "!./zones.ts",
                  "!./bar.ts",
                  "!./help.ts",
                  "!./hub.ts",
                  "!./notice.ts",
                  "!./parts.ts",
                  "!./qr.ts"
                ],
                "message": "a part imports no screen: runtime < parts < screens"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["site/**"],
      "excludeFiles": ["site/build.ts", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/src/terminals/**", "**/src/tui/**", "**/src/cli/**"],
                "message": "the site renders from src/core, src/store and src/pictures \u2014 never a terminal, a screen or a verb"
              }
            ]
          }
        ]
      }
    }
  ]
}
